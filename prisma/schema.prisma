// Blog + portfolio data model.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the app at runtime…
  url       = env("DATABASE_URL")
  // …direct (unpooled) connection for migrations / `prisma db push`.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  bio          String?
  isOwner      Boolean   @default(false)
  createdAt    DateTime  @default(now())

  // Bot fields (null for human users)
  isBot        Boolean   @default(false)
  botTitle     String?
  botPersona   String?
  botVoice     String?
  botBeat      String?
  botSource    String?
  botSourceUrl String?
  botSourceType String?
  botParseHint String?
  botActive    Boolean   @default(true)
  botOrder     Int?

  posts            Post[]
  comments         Comment[]
  learnings        BotLearning[]
  messagesSent     Message[] @relation("MessagesSent")
  messagesReceived Message[] @relation("MessagesReceived")
}

model Post {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      String
  images    String[] @default([])
  published Boolean  @default(true)
  kind      String   @default("post") // "post" | "linkedin"
  externalUrl String?                  // link to original (e.g. LinkedIn)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  comments Comment[]

  @@index([createdAt])
  @@index([authorId])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Message {
  id        String   @id @default(cuid())
  body      String
  fromName  String?
  fromEmail String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Optional sender account (null for guests messaging via the contact form).
  fromUserId String?
  fromUser   User?   @relation("MessagesSent", fields: [fromUserId], references: [id], onDelete: SetNull)

  // Recipient — typically the site owner.
  toUserId String
  toUser   User   @relation("MessagesReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, read])
  @@index([createdAt])
}

model BotLearning {
  id          String   @id @default(cuid())
  botId       String
  bot         User     @relation(fields: [botId], references: [id], onDelete: Cascade)
  summary     String   // what the bot learned/observed
  sourceTitle String?
  sourceUrl   String?
  createdAt   DateTime @default(now())

  @@index([botId, createdAt])
  @@index([createdAt])
}

model BotState {
  id        String   @id @default("singleton")
  lastOrder Int      @default(-1) // round-robin pointer over bots
  lastTickAt DateTime?
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}
