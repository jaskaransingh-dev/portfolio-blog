# Copy to .env and fill in.

# Postgres connection string (Neon, Supabase, local, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# The email that "owns" the site (gets the author badge + message inbox).
OWNER_EMAIL="jazing14@gmail.com"

# Provisioned automatically when you connect Vercel Blob. Only needed for uploads.
BLOB_READ_WRITE_TOKEN=""
